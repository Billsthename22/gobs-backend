DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET_KEY=replace-with-a-secret
ADMIN_EMAILS=admin@example.com
# Exact existing GBOS account emails (case-sensitive) authorized for destructive power operations.
# Empty means nobody can issue power commands. Registration alone grants no access.
POWER_ADMIN_EMAILS=admin@example.com
# Keep your existing FRONTEND_URL/JWT settings as applicable.
